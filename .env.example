# Copy this file to .env and fill in real values. Never commit .env.
PATHWAY_APP_NAME=Pathway Staff Portal
PATHWAY_ENV=production
PATHWAY_DEBUG=false

PATHWAY_HOST=0.0.0.0
PATHWAY_PORT=8891

# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# Startup will refuse to run in production with a missing/weak/short key.
PATHWAY_SECRET_KEY=

PATHWAY_SESSION_HOURS=4
PATHWAY_REQUIRE_HTTPS=true
# MFA enrollment/verification is not implemented yet. Leave false, or no staff can log in.
PATHWAY_REQUIRE_MFA=false

# Trust X-Forwarded-Proto only from exact proxy IPs. In production, add your
# Docker bridge gateway IP (e.g. 172.18.0.1), not a broad CIDR.
PATHWAY_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Login brute-force protection
PATHWAY_MAX_LOGIN_ATTEMPTS=5
PATHWAY_LOGIN_LOCKOUT_MINUTES=15

# Set your own strong, unique database password here and in POSTGRES_PASSWORD below.
POSTGRES_PASSWORD=
PATHWAY_DATABASE_URL=postgresql+psycopg://pathway_staff:CHANGE_ME@db:5432/pathway_staff_portal

PATHWAY_STORAGE_BACKEND=local
PATHWAY_STORAGE_ROOT=/data/clients
PATHWAY_S3_BUCKET=
PATHWAY_S3_REGION=

# Dev/demo only — leave unset or false in any hosted/production environment.
PATHWAY_SHOW_DEMO_CREDENTIALS=false
PATHWAY_ALLOW_DEV_SEED_DATA=false
