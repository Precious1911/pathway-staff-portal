PATHWAY_ENV=production
PATHWAY_SECRET_KEY=
PATHWAY_HOST=127.0.0.1
PATHWAY_PORT=8891
PATHWAY_SESSION_HOURS=4
PATHWAY_REQUIRE_HTTPS=true
# MFA enrollment is not implemented; leave false.
PATHWAY_REQUIRE_MFA=false
PATHWAY_STORAGE_ROOT=/srv/pathway-staff-portal/storage
# Add the exact reverse-proxy peer IP (e.g. the Docker bridge gateway), not a broad CIDR.
PATHWAY_TRUSTED_PROXY_IPS=127.0.0.1,::1
